name: Build & Release
on:
  push:
    branches: [ main, master ]
    tags:     [ 'v*' ]

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Unzip & replace source if zip present
        run: |
          ZIP=$(ls *.zip 2>/dev/null | head -1)
          if [ -n "$ZIP" ]; then
            echo "Found zip: $ZIP"
            TMPDIR=$(mktemp -d)
            unzip -q "$ZIP" -d "$TMPDIR"
            ITEMS=$(ls "$TMPDIR" | wc -l)
            FIRST=$(ls "$TMPDIR" | head -1)
            if [ "$ITEMS" -eq 1 ] && [ -d "$TMPDIR/$FIRST" ]; then
              SRCROOT="$TMPDIR/$FIRST"
            else
              SRCROOT="$TMPDIR"
            fi
            rsync -a --exclude='.github' "$SRCROOT/" .
            rm -rf "$TMPDIR" "$ZIP"
            echo "Source replaced."
          fi

      - uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: gradle-${{ hashFiles('**/*.gradle*', '**/gradle-wrapper.properties') }}
          restore-keys: gradle-

      - name: Build
        run: |
          if [ ! -f gradlew ]; then
            wget -q https://services.gradle.org/distributions/gradle-8.8-bin.zip -O /tmp/gradle.zip
            unzip -q /tmp/gradle.zip -d /opt/gradle
            export PATH="/opt/gradle/gradle-8.8/bin:$PATH"
            gradle wrapper --gradle-version 8.8
          fi
          chmod +x gradlew
          SUCCESS=false
          for i in 1 2 3; do
            if ./gradlew build --no-daemon --max-workers 2; then
              SUCCESS=true
              break
            fi
            echo "Retry $i failed, waiting 30s..."
            sleep 30
          done
          if [ "$SUCCESS" != "true" ]; then exit 1; fi
          echo "=== build/libs ===" && ls -la build/libs/

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: mod-${{ github.sha }}
          path: |
            build/libs/*.jar
            !build/libs/*-dev.jar
            !build/libs/*-sources.jar
          if-no-files-found: error
          retention-days: 30
